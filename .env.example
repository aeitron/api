# ==============================================================================
# Aeitron API Gateway — Environment Configuration Template
# Copy this file to .env and configure for your local/production environment.
# NEVER commit real .env files with production secrets to version control.
# ==============================================================================

# Server Listener
PORT=8000
HOST=0.0.0.0

# Environment Mode: 'development' | 'production' | 'test'
# In 'production', AEITRON_JWT_SECRET is strictly required (minimum 32 bytes)
# and admin diagnostic endpoints (/v1/gateway/routes) fail closed without authorization.
AEITRON_ENV=development
AEITRON_DEV_MODE=true

# Cryptographic Authentication (HMAC-SHA256)
# Required in production: must be a high-entropy secret >= 32 characters
AEITRON_JWT_SECRET=your-32-character-cryptographic-secret-here

# CORS Origin Allowlist (comma-separated list of permitted origins)
# Example: https://aeitron.com,https://dashboard.aeitron.com
AEITRON_CORS_ALLOWED_ORIGINS=https://aeitron.com,https://app.aeitron.com,http://localhost:3000

# Pluggable Distributed State (Redis / KeyDB)
# Optional: leave empty for local in-memory state, or configure Redis URL for multi-PoP cluster
REDIS_URL=redis://127.0.0.1:6379/0
# In production, set to true to enforce fail-closed rejection on Redis disconnects
AEITRON_CLUSTER_FAIL_CLOSED=false

# Durable Audit Storage
# In production mode, durable storage is mandatory to prevent audit record loss
AEITRON_AUDIT_LOG_FILE=/var/log/aeitron/audit.log

# Metrics Authentication Token
# Required in production mode to authenticate Prometheus scrapers on /metrics
AEITRON_METRICS_TOKEN=your-high-entropy-metrics-scrape-token-here

# Upstream Backend Microservices (Decoupled Architecture)
AEITRON_COMMERCE_URL=http://127.0.0.1:8098
AEITRON_BILLING_URL=http://127.0.0.1:8097
AEITRON_ROUTER_URL=http://127.0.0.1:9090
AEITRON_EDGE_URL=http://127.0.0.1:9091
AEITRON_AUTH_URL=http://127.0.0.1:9092
AEITRON_DNS_URL=http://127.0.0.1:8053
AEITRON_SECURITY_URL=http://127.0.0.1:8054
AEITRON_DATABASES_URL=http://127.0.0.1:9095
AEITRON_FLEET_URL=http://127.0.0.1:9096
AEITRON_STATUS_URL=http://127.0.0.1:3002

